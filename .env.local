VITE_API_URL=http://localhost:3000

VITE_LOGIN_DISABLED=${VITE_LOGIN_DISABLED}

VITE_AUTH_LOGOUT_URL=http://localhost:5173

# GOV.UK Pay integration
VITE_GOVPAY_API_URL=http://localhost:3000/api/payments
VITE_GOVPAY_CALLBACK_URL=http://localhost:5173/payment/callback

# Session timeout configuration (in seconds)
VITE_SESSION_TIMEOUT_SECONDS=1800
VITE_SESSION_WARNING_SECONDS=120
VITE_USE_LEGACY_BACKEND_PREFIX=false

# Google Analytics 4
VITE_ENABLE_GA4=false
VITE_GA4_MEASUREMENT_ID=

# Google Tag Manager
VITE_ENABLE_GTM=false
VITE_GTM_ID=
