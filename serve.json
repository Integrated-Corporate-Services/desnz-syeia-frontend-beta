{
  "public": "dist-serve",
  "redirects": [
    { "source": "/", "destination": "/frontend" }
  ],
  "rewrites": [
    { "source": "/frontend/**", "destination": "/frontend/index.html" }
  ],
  "headers": [
    {
      "source": "**/*.@(js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
