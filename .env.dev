API_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

VITE_LOGIN_DISABLED=${VITE_LOGIN_DISABLED}

VITE_AUTH_LOGIN_URL=http://localhost:3000/backend/auth/login
VITE_AUTH_LOGOUT_URL=http://localhost:5173/frontend
VITE_LOGOUT_URL=http://localhost:3000/backend/logout

# Feature toggle for sandbox routes
VITE_SANDBOX_ROUTES_ENABLED=true

# Session timeout configuration (in seconds)
VITE_SESSION_TIMEOUT_SECONDS=1800
VITE_SESSION_WARNING_SECONDS=120
VITE_SIGNED_OUT_PATH=/frontend/signed-out

# S3 presigned URL configuration (in seconds)
VITE_S3_URL_EXPIRY_SECONDS=1800
VITE_S3_REFRESH_BEFORE_EXPIRY_SECONDS=120
